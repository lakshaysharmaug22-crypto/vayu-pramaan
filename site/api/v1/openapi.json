{
 "openapi": "3.1.0",
 "info": {
  "title": "Vayu Pramaan open data API",
  "version": "1.0.0",
  "description": "Static JSON endpoints rebuilt daily at 06:00 IST. No key, no rate limit."
 },
 "paths": {
  "/api/v1/aqi/daily.json": {
   "get": {
    "summary": "Delhi city AQI, daily",
    "description": "CPCB method: mean of station AQIs (PM2.5 + PM10 sub-indices, \u226516 valid hours).",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "generated_at": {
           "type": "string",
           "format": "date-time"
          },
          "rows": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "date": {
              "type": "string"
             },
             "aqi": {
              "type": "integer"
             },
             "band": {
              "type": "string"
             },
             "grap": {
              "type": "string"
             },
             "pm25": {
              "type": "number"
             },
             "pm10": {
              "type": "number"
             },
             "n_stations": {
              "type": "integer"
             }
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/aqi/stations-latest.json": {
   "get": {
    "summary": "Station AQI, latest full day",
    "description": "One row per reporting station.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "generated_at": {
           "type": "string",
           "format": "date-time"
          },
          "rows": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "station": {
              "type": "string"
             },
             "date": {
              "type": "string"
             },
             "aqi": {
              "type": "number"
             },
             "pm25": {
              "type": "number"
             },
             "pm10": {
              "type": "number"
             },
             "hours": {
              "type": "integer"
             }
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
