[{"id":"lag","title":"How long does smoke take to reach Delhi?","sql":"with d as (\n  select a.date, a.aqi, f.fires\n  from v_aqi_daily a join v_fires_upwind f using (date)\n  where month(a.date) in (10, 11))\nselect k * 24 as lag_h,\n       round(corr(aqi, fires_lag), 3) as r\nfrom (select k, aqi, lag(fires, k) over (partition by k order by date) as fires_lag\n      from d, range(0, 6) t(k))\ngroup by k order by k","rows":[{"lag_h":0,"r":0.66},{"lag_h":24,"r":0.767},{"lag_h":48,"r":0.701},{"lag_h":72,"r":0.701},{"lag_h":96,"r":0.698},{"lag_h":120,"r":0.696}],"takeaway":"Fire counts match Delhi AQI best 24 hours later (r = 0.77)."},{"id":"wind","title":"Does northwest wind make fire days worse?","sql":"select case when w.nw_frac >= 0.5 then 'Northwest wind' else 'Other wind' end as wind,\n       round(avg(a.aqi)) as avg_aqi, count(*) as days\nfrom v_aqi_daily a\njoin v_wind_daily w on w.date = a.date\njoin v_fires_upwind f on f.date = a.date - 1\nwhere f.fires >= (select quantile_cont(fires, 0.75) from v_fires_upwind\n                  where month(date) in (10, 11) and fires > 0)\ngroup by wind order by wind","rows":[{"wind":"Northwest wind","avg_aqi":453.0,"days":108},{"wind":"Other wind","avg_aqi":391.0,"days":30}],"takeaway":"After heavy-fire days, AQI averages 453 with northwest wind vs 391 otherwise, +62 points."},{"id":"floor","title":"What is Delhi's own pollution floor?","sql":"select round(median(a.aqi)) as local_floor,\n       round(quantile_cont(a.aqi, 0.25)) as p25,\n       round(quantile_cont(a.aqi, 0.75)) as p75,\n       count(*) as days\nfrom v_aqi_daily a\njoin v_fires_upwind f on f.date = a.date - 1\nwhere month(a.date) in (10, 11, 12) and f.fires < 20","rows":[{"local_floor":320.0,"p25":283.0,"p75":339.0,"days":323}],"takeaway":"With almost no farm fires, Delhi still sits at a median AQI of 320 (323 days)."},{"id":"states","title":"Which state drives the fires?","sql":"select year(date) as season,\n       sum(fires_punjab) as punjab, sum(fires_haryana) as haryana,\n       round(sum(fires_punjab) * 100.0 / nullif(sum(fires), 0), 1) as punjab_pct\nfrom v_fires_upwind\nwhere month(date) in (10, 11)\ngroup by season having sum(fires) > 0 order by season","rows":[{"season":2017,"punjab":51146.0,"haryana":11650.0,"punjab_pct":81.4},{"season":2018,"punjab":46819.0,"haryana":12309.0,"punjab_pct":79.2},{"season":2019,"punjab":41957.0,"haryana":12738.0,"punjab_pct":76.7},{"season":2020,"punjab":40219.0,"haryana":13755.0,"punjab_pct":74.5},{"season":2021,"punjab":33225.0,"haryana":14620.0,"punjab_pct":69.4},{"season":2022,"punjab":30110.0,"haryana":14431.0,"punjab_pct":67.6},{"season":2023,"punjab":25665.0,"haryana":13238.0,"punjab_pct":66.0},{"season":2024,"punjab":21062.0,"haryana":12404.0,"punjab_pct":62.9},{"season":2025,"punjab":17058.0,"haryana":10414.0,"punjab_pct":62.1}],"takeaway":"Punjab's share of upwind fires moved from 81% in 2017 to 62% in 2025."},{"id":"calendar","title":"How big are the Diwali and weekend effects?","sql":"with dw(d) as (values ('2017-10-19'), ('2018-11-07'), ('2019-10-27'), ('2020-11-14'), ('2021-11-04'), ('2022-10-24'), ('2023-11-12'), ('2024-10-31'), ('2025-10-20'), ('2026-11-08'))\nselect case when exists (select 1 from dw where abs(a.date - dw.d::date) <= 1) then 'Diwali \u00b11 day'\n            when dayofweek(a.date) in (0, 6) then 'Weekend'\n            else 'Weekday' end as bucket,\n       round(avg(a.aqi)) as avg_aqi, count(*) as days\nfrom v_aqi_daily a\nwhere month(a.date) in (10, 11)\ngroup by bucket order by avg_aqi desc","rows":[{"bucket":"Diwali \u00b11 day","avg_aqi":412.0,"days":27},{"bucket":"Weekday","avg_aqi":294.0,"days":374},{"bucket":"Weekend","avg_aqi":283.0,"days":148}],"takeaway":"Diwali days average 412 vs 294 on other weekdays. weekends run 11 points lower."},{"id":"cams","title":"Where does the global model miss?","sql":"select count(*) filter (where c.aqi_equiv <= 400) as cams_missed,\n       count(*) as severe_days,\n       round(avg(a.aqi - c.aqi_equiv)) as avg_underestimate\nfrom v_aqi_daily a\njoin v_cams_daily c on c.date = a.date\nwhere a.aqi > 400","rows":[{"cams_missed":50,"severe_days":51,"avg_underestimate":107.0}],"points":[{"date":"2022-10-01","observed":106,"cams":88},{"date":"2022-10-02","observed":70,"cams":38},{"date":"2022-10-03","observed":67,"cams":44},{"date":"2022-10-04","observed":72,"cams":47},{"date":"2022-10-05","observed":98,"cams":22},{"date":"2022-10-06","observed":54,"cams":14},{"date":"2022-10-07","observed":136,"cams":18},{"date":"2022-10-08","observed":53,"cams":41},{"date":"2022-10-09","observed":88,"cams":39},{"date":"2022-10-10","observed":134,"cams":88},{"date":"2022-10-11","observed":166,"cams":75},{"date":"2022-10-12","observed":136,"cams":43},{"date":"2022-10-13","observed":264,"cams":109},{"date":"2022-10-14","observed":269,"cams":172},{"date":"2022-10-15","observed":143,"cams":84},{"date":"2022-10-16","observed":114,"cams":80},{"date":"2022-10-17","observed":166,"cams":115},{"date":"2022-10-18","observed":208,"cams":159},{"date":"2022-10-19","observed":263,"cams":217},{"date":"2022-10-20","observed":288,"cams":185},{"date":"2022-10-21","observed":321,"cams":229},{"date":"2022-10-22","observed":288,"cams":229},{"date":"2022-10-23","observed":371,"cams":312},{"date":"2022-10-24","observed":350,"cams":312},{"date":"2022-10-25","observed":407,"cams":337},{"date":"2022-10-26","observed":364,"cams":266},{"date":"2022-10-27","observed":336,"cams":246},{"date":"2022-10-28","observed":435,"cams":339},{"date":"2022-10-29","observed":457,"cams":309},{"date":"2022-10-30","observed":285,"cams":69},{"date":"2022-10-31","observed":413,"cams":321},{"date":"2022-11-01","observed":297,"cams":222},{"date":"2022-11-02","observed":419,"cams":317},{"date":"2022-11-03","observed":425,"cams":156},{"date":"2022-11-04","observed":375,"cams":310},{"date":"2022-11-05","observed":404,"cams":314},{"date":"2022-11-06","observed":397,"cams":327},{"date":"2022-11-07","observed":430,"cams":318},{"date":"2022-11-