[{"id":"lag","title":"How long does smoke take to reach Delhi?","sql":"with d as (\n  select a.date, a.aqi, f.fires\n  from v_aqi_daily a join v_fires_upwind f using (date)\n  where month(a.date) in (10, 11))\nselect k * 24 as lag_h,\n       round(corr(aqi, fires_lag), 3) as r\nfrom (select k, aqi, lag(fires, k) over (partition by k order by date) as fires_lag\n      from d, range(0, 6) t(k))\ngroup by k order by k","rows":[{"lag_h":0,"r":0.677},{"lag_h":24,"r":0.777},{"lag_h":48,"r":0.705},{"lag_h":72,"r":0.709},{"lag_h":96,"r":0.717},{"lag_h":120,"r":0.714}],"takeaway":"Fire counts match Delhi AQI best 24 hours later (r = 0.78)."},{"id":"wind","title":"Does northwest wind make fire days worse?","sql":"select case when w.nw_frac >= 0.5 then 'Northwest wind' else 'Other wind' end as wind,\n       round(avg(a.aqi)) as avg_aqi, count(*) as days\nfrom v_aqi_daily a\njoin v_wind_daily w on w.date = a.date\njoin v_fires_upwind f on f.date = a.date - 1\nwhere f.fires >= (select quantile_cont(fires, 0.75) from v_fires_upwind\n                  where month(date) in (10, 11) and fires > 0)\ngroup by wind order by wind","rows":[{"wind":"Northwest wind","avg_aqi":455.0,"days":110},{"wind":"Other wind","avg_aqi":401.0,"days":28}],"takeaway":"After heavy-fire days, AQI averages 455 with northwest wind vs 401 otherwise, +54 points."},{"id":"floor","title":"What is Delhi's own pollution floor?","sql":"select round(median(a.aqi)) as local_floor,\n       round(quantile_cont(a.aqi, 0.25)) as p25,\n       round(quantile_cont(a.aqi, 0.75)) as p75,\n       count(*) as days\nfrom v_aqi_daily a\njoin v_fires_upwind f on f.date = a.date - 1\nwhere month(a.date) in (10, 11, 12) and f.fires < 20","rows":[{"local_floor":321.0,"p25":276.0,"p75":339.0,"days":323}],"takeaway":"With almost no farm fires, Delhi still sits at a median AQI of 321 (323 days)."},{"id":"states","title":"Which state drives the fires?","sql":"select year(date) as season,\n       sum(fires_punjab) as punjab, sum(fires_haryana) as haryana,\n       round(sum(fires_punjab) * 100.0 / nullif(sum(fires), 0), 1) as punjab_pct\nfrom v_fires_upwind\nwhere month(date) in (10, 11)\ngroup by season having sum(fires) > 0 order by season","rows":[{"season":2017,"punjab":51183.0,"haryana":11613.0,"punjab_pct":81.5},{"season":2018,"punjab":46910.0,"haryana":12218.0,"punjab_pct":79.3},{"season":2019,"punjab":42355.0,"haryana":12340.0,"punjab_pct":77.4},{"season":2020,"punjab":39828.0,"haryana":14146.0,"punjab_pct":73.8},{"season":2021,"punjab":33066.0,"haryana":14779.0,"punjab_pct":69.1},{"season":2022,"punjab":30314.0,"haryana":14227.0,"punjab_pct":68.1},{"season":2023,"punjab":25698.0,"haryana":13205.0,"punjab_pct":66.1},{"season":2024,"punjab":20983.0,"haryana":12483.0,"punjab_pct":62.7},{"season":2025,"punjab":17034.0,"haryana":10438.0,"punjab_pct":62.0}],"takeaway":"Punjab's share of upwind fires moved from 82% in 2017 to 62% in 2025."},{"id":"calendar","title":"How big are the Diwali and weekend effects?","sql":"with dw(d) as (values ('2017-10-19'), ('2018-11-07'), ('2019-10-27'), ('2020-11-14'), ('2021-11-04'), ('2022-10-24'), ('2023-11-12'), ('2024-10-31'), ('2025-10-20'), ('2026-11-08'))\nselect case when exists (select 1 from dw where abs(a.date - dw.d::date) <= 1) then 'Diwali \u00b11 day'\n            when dayofweek(a.date) in (0, 6) then 'Weekend'\n            else 'Weekday' end as bucket,\n       round(avg(a.aqi)) as avg_aqi, count(*) as days\nfrom v_aqi_daily a\nwhere month(a.date) in (10, 11)\ngroup by bucket order by avg_aqi desc","rows":[{"bucket":"Diwali \u00b11 day","avg_aqi":414.0,"days":27},{"bucket":"Weekday","avg_aqi":297.0,"days":374},{"bucket":"Weekend","avg_aqi":284.0,"days":148}],"takeaway":"Diwali days average 414 vs 297 on other weekdays. weekends run 13 points lower."},{"id":"cams","title":"Where does the global model miss?","sql":"select count(*) filter (where c.aqi_equiv <= 400) as cams_missed,\n       count(*) as severe_days,\n       round(avg(a.aqi - c.aqi_equiv)) as avg_underestimate\nfrom v_aqi_daily a\njoin v_cams_daily c on c.date = a.date\nwhere a.aqi > 400","rows":[{"cams_missed":54,"severe_days":55,"avg_underestimate":112.0}],"points":[{"date":"2022-10-01","observed":81,"cams":50},{"date":"2022-10-02","observed":52,"cams":8},{"date":"2022-10-03","observed":20,"cams":12},{"date":"2022-10-04","observed":51,"cams":13},{"date":"2022-10-05","observed":58,"cams":29},{"date":"2022-10-06","observed":131,"cams":83},{"date":"2022-10-07","observed":182,"cams":71},{"date":"2022-10-08","observed":96,"cams":88},{"date":"2022-10-09","observed":94,"cams":86},{"date":"2022-10-10","observed":81,"cams":44},{"date":"2022-10-11","observed":102,"cams":167},{"date":"2022-10-12","observed":117,"cams":71},{"date":"2022-10-13","observed":207,"cams":166},{"date":"2022-10-14","observed":158,"cams":82},{"date":"2022-10-15","observed":101,"cams":165},{"date":"2022-10-16","observed":100,"cams":71},{"date":"2022-10-17","observed":170,"cams":94},{"date":"2022-10-18","observed":260,"cams":234},{"date":"2022-10-19","observed":219,"cams":86},{"date":"2022-10-20","observed":310,"cams":169},{"date":"2022-10-21","observed":320,"cams":153},{"date":"2022-10-22","observed":236,"cams":81},{"date":"2022-10-23","observed":380,"cams":330},{"date":"2022-10-24","observed":374,"cams":267},{"date":"2022-10-25","observed":381,"cams":303},{"date":"2022-10-26","observed":338,"cams":138},{"date":"2022-10-27","observed":357,"cams":301},{"date":"2022-10-28","observed":457,"cams":308},{"date":"2022-10-29","observed":408,"cams":333},{"date":"2022-10-30","observed":238,"cams":83},{"date":"2022-10-31","observed":353,"cams":260},{"date":"2022-11-01","observed":342,"cams":305},{"date":"2022-11-02","observed":458,"cams":310},{"date":"2022-11-03","observed":500,"cams":492},{"date":"2022-11-04","observed":371,"cams":312},{"date":"2022-11-05","observed":386,"cams":272},{"date":"2022-11-06","observed":364,"cams":189},{"date":"2022-11-07","observed":473,"cams":341},{"date":"2022-11-08"