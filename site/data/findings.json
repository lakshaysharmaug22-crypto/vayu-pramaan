[{"id":"lag","title":"How long does smoke take to reach Delhi?","sql":"with d as (\n  select a.date, a.aqi, f.fires\n  from v_aqi_daily a join v_fires_upwind f using (date)\n  where month(a.date) in (10, 11))\nselect k * 24 as lag_h,\n       round(corr(aqi, fires_lag), 3) as r\nfrom (select k, aqi, lag(fires, k) over (partition by k order by date) as fires_lag\n      from d, range(0, 6) t(k))\ngroup by k order by k","rows":[{"lag_h":0,"r":0.362},{"lag_h":24,"r":0.378},{"lag_h":48,"r":0.367},{"lag_h":72,"r":0.354},{"lag_h":96,"r":0.347},{"lag_h":120,"r":0.334}],"takeaway":"Fire counts match Delhi AQI best 24 hours later (r = 0.38)."},{"id":"wind","title":"Does northwest wind make fire days worse?","sql":"select case when w.nw_frac >= 0.5 then 'Northwest wind' else 'Other wind' end as wind,\n       round(avg(a.aqi)) as avg_aqi, count(*) as days\nfrom v_aqi_daily a\njoin v_wind_daily w on w.date = a.date\njoin v_fires_upwind f on f.date = a.date - 1\nwhere f.fires >= (select quantile_cont(fires, 0.75) from v_fires_upwind\n                  where month(date) in (10, 11) and fires > 0)\ngroup by wind order by wind","rows":[{"wind":"Northwest wind","avg_aqi":339.0,"days":76},{"wind":"Other wind","avg_aqi":308.0,"days":84}],"takeaway":"After heavy-fire days, AQI averages 339 with northwest wind vs 308 otherwise, +31 points."},{"id":"floor","title":"What is Delhi's own pollution floor?","sql":"select round(median(a.aqi)) as local_floor,\n       round(quantile_cont(a.aqi, 0.25)) as p25,\n       round(quantile_cont(a.aqi, 0.75)) as p75,\n       count(*) as days\nfrom v_aqi_daily a\njoin v_fires_upwind f on f.date = a.date - 1\nwhere month(a.date) in (10, 11, 12) and f.fires < 20","rows":[{"local_floor":341.0,"p25":260.0,"p75":394.0,"days":225}],"takeaway":"With almost no farm fires, Delhi still sits at a median AQI of 341 (225 days)."},{"id":"states","title":"Which state drives the fires?","sql":"select year(date) as season,\n       sum(fires_punjab) as punjab, sum(fires_haryana) as haryana,\n       round(sum(fires_punjab) * 100.0 / nullif(sum(fires), 0), 1) as punjab_pct\nfrom v_fires_upwind\nwhere month(date) in (10, 11)\ngroup by season having sum(fires) > 0 order by season","rows":[{"season":2017,"punjab":57392.0,"haryana":11490.0,"punjab_pct":83.3},{"season":2018,"punjab":57460.0,"haryana":9402.0,"punjab_pct":85.9},{"season":2019,"punjab":44729.0,"haryana":6239.0,"punjab_pct":87.8},{"season":2020,"punjab":75202.0,"haryana":5857.0,"punjab_pct":92.8},{"season":2021,"punjab":77955.0,"haryana":10647.0,"punjab_pct":88.0},{"season":2022,"punjab":46434.0,"haryana":4641.0,"punjab_pct":90.9},{"season":2023,"punjab":30960.0,"haryana":2904.0,"punjab_pct":91.4},{"season":2024,"punjab":9056.0,"haryana":1847.0,"punjab_pct":83.1}],"takeaway":"Punjab's share of upwind fires moved from 83% in 2017 to 83% in 2024."},{"id":"calendar","title":"How big are the Diwali and weekend effects?","sql":"with dw(d) as (values ('2017-10-19'), ('2018-11-07'), ('2019-10-27'), ('2020-11-14'), ('2021-11-04'), ('2022-10-24'), ('2023-11-12'), ('2024-10-31'), ('2025-10-20'), ('2026-11-08'))\nselect case when exists (select 1 from dw where abs(a.date - dw.d::date) <= 1) then 'Diwali \u00b11 day'\n            when dayofweek(a.date) in (0, 6) then 'Weekend'\n            else 'Weekday' end as bucket,\n       round(avg(a.aqi)) as avg_aqi, count(*) as days\nfrom v_aqi_daily a\nwhere month(a.date) in (10, 11)\ngroup by bucket order by avg_aqi desc","rows":[{"bucket":"Diwali \u00b11 day","avg_aqi":341.0,"days":27},{"bucket":"Weekend","avg_aqi":293.0,"days":139},{"bucket":"Weekday","avg_aqi":291.0,"days":352}],"takeaway":"Diwali days average 341 vs 291 on other weekdays. weekends run -2 points lower."},{"id":"cams","title":"Where does the global model miss?","sql":"select count(*) filter (where c.aqi_equiv <= 400) as cams_missed,\n       count(*) as severe_days,\n       round(avg(a.aqi - c.aqi_equiv)) as avg_underestimate\nfrom v_aqi_daily a\njoin v_cams_daily c on c.date = a.date\nwhere a.aqi > 400","rows":[{"cams_missed":72,"severe_days":76,"avg_underestimate":138.0}],"points":[{"date":"2022-10-01","observed":199,"cams":214},{"date":"2022-10-02","observed":182,"cams":225},{"date":"2022-10-03","observed":129,"cams":88},{"date":"2022-10-04","observed":153,"cams":123},{"date":"2022-10-05","observed":210,"cams":300},{"date":"2022-10-06","observed":67,"cams":54},{"date":"2022-10-07","observed":56,"cams":39},{"date":"2022-10-08","observed":53,"cams":43},{"date":"2022-10-09","observed":43,"cams":35},{"date":"2022-10-10","observed":49,"cams":61},{"date":"2022-10-11","observed":84,"cams":58},{"date":"2022-10-12","observed":150,"cams":95},{"date":"2022-10-13","observed":137,"cams":105},{"date":"2022-10-14","observed":173,"cams":107},{"date":"2022-10-15","observed":206,"cams":217},{"date":"2022-10-16","observed":246,"cams":311},{"date":"2022-10-17","observed":254,"cams":274},{"date":"2022-10-18","observed":258,"cams":265},{"date":"2022-10-19","observed":247,"cams":295},{"date":"2022-10-20","observed":255,"cams":182},{"date":"2022-10-21","observed":276,"cams":257},{"date":"2022-10-22","observed":277,"cams":313},{"date":"2022-10-23","observed":283,"cams":274},{"date":"2022-10-24","observed":314,"cams":152},{"date":"2022-10-25","observed":300,"cams":143},{"date":"2022-10-26","observed":307,"cams":311},{"date":"2022-10-27","observed":359,"cams":329},{"date":"2022-10-28","observed":381,"cams":361},{"date":"2022-10-29","observed":389,"cams":341},{"date":"2022-10-30","observed":370,"cams":336},{"date":"2022-10-31","observed":408,"cams":338},{"date":"2022-11-01","observed":401,"cams":370},{"date":"2022-11-02","observed":396,"cams":321},{"date":"2022-11-03","observed":454,"cams":213},{"date":"2022-11-04","observed":447,"cams":329},{"date":"2022-11-05","observed":356,"cams":314},{"date":"2022-11-06","observed":336,"cams":318},{"date":"2022-11-07","observed":345,"cams":322},{"date":"2022-11-08","observed":398,"cams":295},{"date":"2022-11-09","observed":228,"